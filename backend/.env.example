# Copy to .env and fill in. NEVER commit the real .env.

# MongoDB Atlas connection string (the processed-session cache).
# Free M0 tier is plenty: ~65 KB per session, 512 MB limit.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=f1_replay
MONGODB_CACHE_COLLECTION=session_cache

# Set to 0 to run without any cache (every request re-parses — slow).
CACHE_ENABLED=1

# Comma-separated production frontend origins for CORS.
# localhost/127.0.0.1 on any port is always allowed.
ALLOWED_ORIGINS=https://your-site.pages.dev
